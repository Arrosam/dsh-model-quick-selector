{
  "name": "dsh-model-quick-selector",
  "version": "2.4.0",
  "description": "Quick-select model list for the DSH model selector: choose and order models from the model menu settings icon, drag vertically to switch between them",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-selector",
    "quick-select",
    "reasoning-effort",
    "slider",
    "i18n",
    "ui"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "locale",
    "cordis.patch.yml",
    "screenshots.json",
    "install-profile.ps1",
    "install.cmd",
    "LICENSE",
    "test",
    "preview",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/client.test.mjs && node test/seat-drag.test.mjs && node test/quick-select.test.mjs",
    "preview": "node preview/make-preview.mjs",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pack-dist.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
